<?xml version="1.0" encoding="utf-8"?>
<com.sociallimiter.app.overlay.BlockingFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20E1114">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            tools:ignore="HardcodedText"
            android:text="Time's up" />

        <TextView
            android:id="@+id/lockedAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9FB3C8"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            tools:ignore="HardcodedText"
            android:text="App" />

        <TextView
            android:id="@+id/lockedRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#FFB86B"
            android:textSize="44sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:text="15:00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9FB3C8"
            android:textSize="16sp"
            android:gravity="center"
            tools:ignore="HardcodedText"
            android:text="locked until the timer ends" />

        <Button
            android:id="@+id/lockedHome"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="#4C8BF5"
            android:textColor="#FFFFFF"
            tools:ignore="HardcodedText"
            android:text="Take me home" />
    </LinearLayout>
</com.sociallimiter.app.overlay.BlockingFrameLayout>
